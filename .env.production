# 正式环境 API Base URL
VITE_API_BASE_URL=https://syngents-api.frontis.cn

# 正式环境 Log Level
VITE_APP_LOG_LEVEL=info

# 飞书机器人 Webhook（可选）：配置后接口报错将统一上报到飞书群
VITE_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/30d2cdd4-b9ec-4661-ae71-a91cf5425454

# 飞书签名校验密钥（可选）：在飞书机器人「安全设置」中开启「签名校验」后，把生成的密钥填于此，请求会带签名，仅带正确签名的请求才会被飞书接受
VITE_FEISHU_WEBHOOK_SECRET=c8Y5SKWDnoT3ZVvuLBiCC

# CDN 静态资源基础路径（构建后所有 JS/CSS/图片/字体引用都会指向此地址）
# 部署前请先将 dist/assets/ 目录上传到 CDN 对应路径
# 若暂不使用 CDN，注释掉此行即可回退到 nginx 直接提供静态资源
# VITE_CDN_BASE=https://cdn.syngents.cn/syngents/
